[Unit]
Description=NAT-PMP port forwarding for qBittorrent (ProtonVPN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/data/scripts/natpmp-qbit.env
ExecStart=/data/scripts/natpmp-qbit.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
