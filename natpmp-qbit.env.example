# NAT-PMP + qBittorrent configuration
# Copy this to natpmp-qbit.env and fill in your values.

# --- Required ---

# NAT-PMP server (VPN provider's gateway IP inside the tunnel)
GATEWAY=10.2.0.1

# WireGuard interface name on the UDM (check Unifi Network > VPN)
WG_IFACE=wgclt1

# Local WireGuard IP (your side of the tunnel)
WG_SRC=10.2.0.2

# VLAN bridge interface where qBittorrent lives
# On UDM, VLANs appear as brXXX (e.g., br971 for VLAN 971)
VLAN_IFACE=br971

# qBittorrent's IP address (reachable from the gateway)
QBIT_HOST=192.168.97.150

# qBittorrent WebUI password
QBIT_PASS=your-password-here

# --- Optional (defaults shown) ---

# QBIT_PORT=8080
# QBIT_USER=admin
# LEASE_TIME=60
# REFRESH_INTERVAL=45       # ProtonVPN leases are 60s; renew well before expiry
# NATPMP_TIMEOUT=15         #natpmpc timeout if hung
